---
// app/(page)/components/page.js, with the metadata from its layout.js. A
// client page in Next.js, though nothing on it is interactive
import Frame from '../layouts/frame.astro'
import Chat from '../components/mdx/chat.astro'
import ChatMessage from '../components/mdx/chat-message.astro'

const metadata = {
  title: 'Components',
  description:
    'A reference page for MDX components used across the iamsteve.me blog.',
  alternates: {
    canonical: '/components',
  },
  robots: {
    index: false,
    follow: true,
  },
}

const usage = `\`\`\`chat:iMessage
L: hello how are you
R: hello I'm good thank you
AI: here's a suggestion for you
\`\`\`

L:  left-aligned (received)
R:  right-aligned (sent)
AI: left-aligned, no background (AI response)`

const heading =
  'font-display font-variation-bold text-lg lowercase text-heading mt-4'
---

<Frame variant="page" metadata={metadata}>
  <article class="col-content py-18 flex flex-col gap-18">
    <header>
      <h1
        class="font-display font-variation-bold text-4xl lowercase text-heading"
      >
        Components
      </h1>
      <p class="text-ui-body text-lg mt-2">
        A reference page for MDX components used across the site.
      </p>
    </header>

    <section class="flex flex-col gap-4 max-w-lg">
      <h2
        class="font-display font-variation-bold text-2xl lowercase text-heading"
      >
        Chat
      </h2>
      <p class="text-ui-body">
        Apple Messages-style conversation bubbles. Use a{' '}<code
          class="text-sm bg-neutral-01-200 dark:bg-neutral-01-800 px-1.5 py-0.5 rounded"
          >chat</code
        >{' '}code fence in markdown.
      </p>

      <h3 class={heading}>With title</h3>
      <Chat title="iMessage">
        <ChatMessage align="left">hello how are you</ChatMessage>
        <ChatMessage align="left">what have you been up to</ChatMessage>
        <ChatMessage align="right">hello I’m good thank you</ChatMessage>
        <ChatMessage align="right">just working on the blog</ChatMessage>
        <ChatMessage align="left">nice, sounds fun</ChatMessage>
      </Chat>

      <h3 class={heading}>Without title</h3>
      <Chat>
        <ChatMessage align="left">have you tried the new feature?</ChatMessage>
        <ChatMessage align="right">not yet, will check it out</ChatMessage>
        <ChatMessage align="right">looks great though</ChatMessage>
        <ChatMessage align="left">let me know what you think</ChatMessage>
      </Chat>

      <h3 class={heading}>With AI responses</h3>
      <Chat title="Claude">
        <ChatMessage align="right">what colour should I use for links?</ChatMessage>
        <ChatMessage align="ai"
          >{
            'I’d recommend a blue with good contrast against your background. Something like cornflour-500 would work well.'
          }</ChatMessage
        >
        <ChatMessage align="right">thanks, that looks great</ChatMessage>
        <ChatMessage align="ai"
          >{'You’re welcome! Make sure it meets AA contrast ratio.'}</ChatMessage
        >
      </Chat>

      <h3 class={heading}>Short exchange</h3>
      <Chat title="Messages">
        <ChatMessage align="right">are you free tomorrow?</ChatMessage>
        <ChatMessage align="left">yes!</ChatMessage>
      </Chat>

      <div class="bg-surface shadow-placed rounded-lg p-6 mt-4">
        <h3
          class="font-display font-variation-bold text-lg lowercase text-heading mb-2"
        >
          Usage
        </h3>
        <pre
          class="text-sm bg-fern-1100 text-neutral-01-200 p-4 rounded-lg overflow-x-auto"><code>{usage}</code></pre>
      </div>
    </section>
  </article>
</Frame>
