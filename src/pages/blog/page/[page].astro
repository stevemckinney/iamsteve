---
// app/(blog)/blog/page/[page]/page.js. Page 1 repeats /blog, as it did
import Frame from '../../../layouts/frame.astro'
import Archive from '../../../components/archive.astro'
import { openPosts, listedCategories, cardPreloads, perPage } from '../../../lib/content.js'

export async function getStaticPaths() {
  const posts = await openPosts()
  const total = Math.ceil(posts.length / perPage)
  return Array.from({ length: total }, (_, index) => ({
    params: { page: String(index + 1) },
    props: { current: index + 1, total, posts },
  }))
}

const { current, total, posts } = Astro.props
const page = posts.slice(perPage * (current - 1), perPage * current)
const description = 'Tips and tutorials about the design and build of web interfaces'

const metadata = {
  title: current > 1 ? `Blog • Page ${current}` : 'Blog',
  description,
  alternates: { canonical: '/blog' },
  robots: current > 1 ? { index: false, follow: true } : undefined,
}
---

<Frame metadata={metadata} preloads={cardPreloads(page[0])}>
  <Archive
    title="Blog"
    description={description}
    categories={await listedCategories()}
    listClass="max-md:hidden md:col-span-1 grid grid-cols-2 gap-x-8 self-end column-categories -mb-2 lg:-mb-3"
    linkClass="py-2 md:py-3 text-base md:text-lg lg:text-xl text-fern-1100 transition-all duration-200 ease-linear font-ui lowercase leading-none flex gap-2 items-center text-current"
    posts={page}
    pagination={{ current, total, base: '/blog' }}
    hideEmptyList
  />
</Frame>
