---
// app/(blog)/blog/page.js
import Frame from '../../layouts/frame.astro'
import Archive from '../../components/archive.astro'
import { openPosts, listedCategories, cardPreloads, perPage } from '../../lib/content.js'
const posts = await openPosts()
const description = 'Tips and tutorials about the design and build of web interfaces'

const metadata = {
  title: 'Blog archive',
  description,
  alternates: { canonical: '/blog' },
}
---

<Frame metadata={metadata} preloads={cardPreloads(posts[0])}>
  <Archive
    title="Blog"
    description={description}
    categories={await listedCategories()}
    listClass="max-md:hidden md:col-span-1 grid grid-cols-2 gap-x-8 self-end column-categories -mb-2 lg:-mb-3"
    linkClass="py-2 md:py-3 text-base md:text-lg lg:text-xl text-emphasis hover:text-link-hover transition-all duration-200 ease-linear font-ui lowercase leading-none flex gap-2 items-center text-current"
    posts={posts.slice(0, perPage)}
    pagination={{ current: 1, total: Math.ceil(posts.length / perPage), base: '/blog' }}
    hideEmptyList
  />
</Frame>
