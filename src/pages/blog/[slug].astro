---
// Posts, rendered through the same MDX pipeline and component map as the
// Next.js site. The post layout around the body (header, featured image,
// table of contents, aside, next posts) comes next
import { getCollection, render } from 'astro:content'
import Frame from '../../layouts/frame.astro'
import { postComponents } from '../../components/mdx/index.js'
import { isRoutable } from '../../lib/content.js'
import siteMetadata from '@/content/metadata'

export async function getStaticPaths() {
  // Closed and draft posts 404, as they do today
  const posts = await getCollection('blog', isRoutable)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, summary, metadesc, date, lastmod, ogImage, noindex } = post.data
const url = `/blog/${post.id}`

// app/(post)/blog/[...slug]/page.js generateMetadata
const metadata = {
  title,
  description: metadesc,
  alternates: {
    canonical: url,
    types: { 'text/markdown': `/api/content/${post.id}` },
  },
  openGraph: {
    title,
    description: summary,
    type: 'article',
    publishedTime: date,
    modifiedTime: lastmod,
    authors: [siteMetadata.author],
    url,
    images: [{ url: ogImage, width: 1200, height: 630, alt: title }],
  },
  twitter: {
    card: 'summary_large_image',
    title,
    description: summary,
    images: [ogImage],
  },
  ...(noindex && {
    robots: {
      index: false,
      follow: false,
      googleBot: { index: false, follow: false },
    },
  }),
}
---

<Frame variant="post" metadata={metadata}>
  <h1 class="col-content lg:col-prose">{title}</h1>
  <div
    class="prose grid grid-cols-subgrid lg:row-start-1 pb-18 gap-x-8 gap-y-0 col-content lg:col-prose lg:col-start-3 lg:col-end-12 xl:col-start-5 xl:col-end-16"
    id="article"
  >
    <Content components={postComponents} />
  </div>
</Frame>

<script>
  import '../../scripts/copy-code.js'
</script>
