---
// app/(page)/newsletter/page.js. The form reads the subscriber count that
// components/newsletter.js fetched, and Campaigns is read at build time.
// ErrorBoundary is left out: it added nothing to the server HTML
import Frame from '../layouts/frame.astro'
import { PencilMono } from '../components/illustration/index.js'
import Header from '../components/page/header.astro'
import Title from '../components/page/title.astro'
import Notepad from '../components/notepad.js'
import NewsletterForm from '../components/newsletter-form.astro'
import Card from '../components/card/index.astro'
import Campaigns from '../components/campaigns.astro'
import { openPosts, cardData } from '../lib/content.js'

// Newest first, as production lists them
const included = [165, 164, 72, 157, 160]
const posts = (await openPosts()).filter((post) =>
  included.includes(post.data.id)
)

const description =
  'Get notified when new articles about design, typography and CSS are published. Monthly at most. Unsubscribe anytime.'

const metadata = {
  title: 'Newsletter',
  description,
  alternates: { canonical: '/newsletter' },
  openGraph: {
    title: 'Newsletter • iamsteve',
    description,
    url: '/newsletter',
    type: 'website',
  },
}

const heading =
  'text-3xl font-display font-variation-bold leading-none lowercase text-heading m-0'
---

<Frame variant="page" metadata={metadata}>
  <PencilMono
    width={962}
    height={46}
    class="col-start-1 col-end-3 row-start-1 max-w-[initial] justify-self-end self-start mt-3 drop-shadow-placed max-2xl:hidden"
  />
  <article class="grid grid-cols-subgrid col-content pb-18 gap-y-18">
    <Header class="col-content">
      <Title>Newsletter</Title>
    </Header>
    <div
      class="col-start-content-start max-lg:col-end-content-end lg:col-span-5 xl:col-span-7 2xl:col-span-6 flex flex-col gap-8"
    >
      <section class="flex flex-col gap-4">
        <h2 class={heading}>Get the articles</h2>
        <div
          class="bg-surface shadow-placed px-10 py-8 rounded-lg flex flex-col gap-4"
        >
          <p>
            Join my email list and I’ll notify you when the latest posts go
            out—if that’s what you prefer. This happens monthly at most. You can
            unsubscribe anytime.
          </p>
          {/* Its field ids are the footer form’s too, as in production */}
          <NewsletterForm />
        </div>
      </section>
      <Notepad>
        <Notepad.Header>Previous issues</Notepad.Header>
        <Notepad.Body>
          <Campaigns />
        </Notepad.Body>
      </Notepad>
    </div>
    <div
      class="col-start-content-start col-end-content-end lg:col-start-6 xl:col-start-9 2xl:col-start-8 flex flex-col gap-4"
    >
      <h2 class={heading}>What you can expect</h2>
      {posts.map((post) => <Card size="small" frontmatter={cardData(post)} />)}
    </div>
  </article>
</Frame>
