---
// components/posts/latest.js
import Title from '../title.astro'
import Card from '../card/index.astro'
import { cardData } from '../../lib/content.js'

const { posts, title, linkText, linkHref } = Astro.props
---

<Title
  link={linkHref}
  text={linkText}
  ariaID="latest"
  class="sm:px-4 md:px-8 sm:-mx-4 md:-mx-8 sm:bg-canvas sm:bg-[url(/images/texture.png)] sm:bg-size-[172px_auto] sm:bg-blend-multiply sm:-mt-4.5 md:-mt-5.5"
>
  {title}
</Title>
<div
  class="grid col-start-margin-start col-end-margin-end sm:col-content gap-4 md:gap-8 max-sm:grid-flow-col max-sm:auto-cols-auto max-sm:overflow-auto max-sm:snap-x max-sm:snap-always max-sm:overscroll-x-contain md:grid-cols-2 max-sm:px-8 max-sm:py-8 max-sm:-my-8"
>
  {
    posts.map((post, index) => (
      <Card
        size="container"
        frontmatter={cardData(post)}
        image={true}
        priority={index === 0}
        class="max-sm:w-[calc(100vw-48px)] max-sm:snap-center md:col-span-1"
      />
    ))
  }
</div>
