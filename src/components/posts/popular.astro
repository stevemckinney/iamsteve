---
// components/posts/popular.js: the most viewed posts, six each for Design,
// Code and All. The cards render here, a list to each slot of the island,
// which shows Design and swaps in the list chosen. The lists it isn’t
// showing travel in the page as Astro’s slot templates
import Card from '../card/index.astro'
import Popular from '../islands/popular.jsx'

const { posts } = Astro.props
const inCategory = (category) =>
  posts.filter((post) => post.categories.includes(category)).slice(0, 6)
const design = inCategory('Design')
const code = inCategory('Code')
const all = posts.slice(0, 6)
const cardClass = 'max-sm:w-[calc(100vw-48px)] max-sm:snap-center md:col-span-1'
---

<Popular client:visible>
  <Fragment slot="design">
    {
      design.map((post) => (
        <Card size="container" frontmatter={post} image={false} class={cardClass} />
      ))
    }
  </Fragment>
  <Fragment slot="code">
    {
      code.map((post) => (
        <Card size="container" frontmatter={post} image={false} class={cardClass} />
      ))
    }
  </Fragment>
  <Fragment slot="all">
    {
      all.map((post) => (
        <Card size="container" frontmatter={post} image={false} class={cardClass} />
      ))
    }
  </Fragment>
</Popular>
