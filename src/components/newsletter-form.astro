---
// The newsletter form island, with the subscriber count read from
// EmailOctopus at build. It hydrates once it’s in view: most forms sit in
// the footer, and the post aside’s is hidden on phones
import NewsletterForm from './islands/newsletter-form.jsx'
import { subscriberCount } from '../lib/newsletter.js'

const { class: className = 'w-full', unique = 'footer' } = Astro.props

// Rounded down to the nearest 10, as components/newsletter.js shows it
const count = Math.floor((await subscriberCount()) / 10) * 10
---

<NewsletterForm
  client:visible
  className={className}
  unique={unique}
  initialCount={count}
/>
