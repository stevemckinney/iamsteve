---
import styles from '@/components/posts/0175-bento-grid/bento.module.css'

const section =
  'gap-2 p-2 bg-(--color-gunmetal-850) ring ring-(--color-gunmetal-750) rounded-sm'
---

<div
  class={`${styles.bento} bg-gunmetal-900 aspect-video flex justify-center p-4 lg:p-8`}
>
  <div
    class="w-full min-h-full grid grid-cols-12 grid-flow-dense auto-rows-auto gap-2"
  >
    <section class={`col-span-6 row-span-4 ${section}`}></section>
    <section class={`col-span-6 row-span-4 ${section}`}></section>
    <section class={`col-span-3 row-span-4 ${section}`}></section>
    <section class={`col-span-6 row-span-4 ${section}`}></section>
    <section class={`col-span-3 row-span-2 ${section}`}></section>
    <section class={`col-span-3 row-span-2 ${section}`}></section>
  </div>
</div>
