---
// The Blockquote component: `style` names a variant, not CSS
const styleVariants = {
  notice: 'border-l-2 border-l-fern-500 pl-4 -ml-4',
  signpost: '',
  afterthought:
    'md:text-lg lg:text-xl border-l border-l-neutral-01-500/20 pl-4 mb-3 text-lg text-ui-body/60 italic',
}

const { style } = Astro.props
---

<blockquote class={styleVariants[style]}><slot /></blockquote>
