---
// `compare` switches between the images in the ComparisonImages island,
// which needs rewriting to take its images as a prop rather than reading
// its children. Until then a comparison shows as a gallery
const { compare = false, options, align } = Astro.props
---

<div
  class="flex col-container grid-cols-subgrid gap-4 overscroll-contain-x overflow-x-auto py-4 -my-4 prose-exclude images px-6 sm:px-12 -mx-6 sm:[mask:linear-gradient(90deg,transparent_0%,#000_32px,#000_calc(100%-32px),transparent_100%)]"
>
  <div class="shrink-0 max-sm:hidden sm:basis-1/5" aria-hidden="true"></div>
  <slot />
</div>
