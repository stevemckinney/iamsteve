---
// Images from components/mdx-post.js: a scrolling strip of images, or
// with `compare`, ComparisonImages switching between them. React read the
// images’ props from its children; here they come back out of the
// rendered slot
import { unified } from 'unified'
import rehypeParse from 'rehype-parse'
import ComparisonImages from '../comparison-images.astro'

const { align, compare = false, options, ...props } = Astro.props

function imagesIn(html) {
  const images = []
  const visit = (node) => {
    if (node.tagName === 'img') {
      const { src, alt, width, height } = node.properties
      images.push({ src, alt, width, height })
    }
    node.children?.forEach(visit)
  }
  visit(unified().use(rehypeParse, { fragment: true }).parse(html))
  return images
}

const images = compare
  ? imagesIn(await Astro.slots.render('default'))
  : undefined
---

{
  compare ? (
    <ComparisonImages options={options} images={images} {...props} />
  ) : (
    <div class="flex col-container grid-cols-subgrid gap-4 overscroll-contain-x overflow-x-auto py-4 -my-4 prose-exclude images px-6 sm:px-12 -mx-6 sm:[mask:linear-gradient(90deg,transparent_0%,#000_32px,#000_calc(100%-32px),transparent_100%)]">
      <div class="shrink-0 max-sm:hidden sm:basis-1/5" aria-hidden="true" />
      <slot />
    </div>
  )
}
