---
// `enlargeable` wraps the figure in the FigureModal trigger. Opening the
// image arrives with the island; until then the trigger is static markup
import FigureModal from '../figure-modal.astro'

const {
  imageShadow,
  enlargeable,
  src,
  alt,
  class: ownClass,
  className = '',
  ...attributes
} = Astro.props

const figureClass =
  `${imageShadow ? '[&_img]:drop-shadow-image [&_img]:rounded-sm' : ''} ${
    ownClass ?? className
  }`.trim() || undefined
---

{
  enlargeable ? (
    <FigureModal alt={alt}>
      <figure class={figureClass} {...attributes}><slot /></figure>
    </FigureModal>
  ) : (
    <figure class={figureClass} {...attributes}><slot /></figure>
  )
}
