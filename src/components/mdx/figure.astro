---
// components/figure.js’s Figure: `enlargeable` wraps the figure in the
// FigureModal trigger, which opens `src` in a lightbox
import FigureModal from '../figure-modal.astro'

const {
  imageShadow,
  enlargeable,
  src,
  alt,
  class: ownClass,
  className = '',
  ...attributes
} = Astro.props

const figureClass =
  `${imageShadow ? '[&_img]:drop-shadow-image [&_img]:rounded-sm' : ''} ${
    ownClass ?? className
  }`.trim() || undefined
---

{
  enlargeable ? (
    <FigureModal src={src} alt={alt}>
      <figure class={figureClass} {...attributes}><slot /></figure>
    </FigureModal>
  ) : (
    <figure class={figureClass} {...attributes}><slot /></figure>
  )
}
