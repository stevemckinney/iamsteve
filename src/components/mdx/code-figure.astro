---
// A titled code block from lib/remark-code-title.js, with its copy button.
// The page includes src/scripts/copy-code.js, so the script stays out of
// the prose, where it would become another child of the grid
import { cn } from '@/lib/utils'
import Icon from '../icon.astro'

const { title, language } = Astro.props
const iconClass = 'absolute top-0 left-0 transition-all duration-200'
---

<figure data-rehype-pretty-code-figure="">
  <figcaption data-rehype-pretty-code-title="" data-language={language}>
    <span class="text-base tracking-normal py-1.5 px-3">{title}</span>
    <button
      type="button"
      tabindex="0"
      class={cn(
        'flex items-center justify-center gap-1.5',
        'leading-normal px-3 py-1.5 rounded-sm',
        'bg-surface',
        'shadow-placed hover:shadow-picked active:shadow-reduced',
        'transition duration-100 ease-out',
        'font-ui cursor-pointer',
        'ml-auto text-body text-base'
      )}
      aria-label="Copy code"
      data-copy-code
    >
      <span class="relative w-4 h-4">
        <Icon icon="copy" size={16} variant="header" class={iconClass} />
        <Icon
          icon="checkmark"
          size={16}
          variant="header"
          class={cn(iconClass, 'opacity-0 scale-75 blur-sm')}
        />
      </span>
      <span>Copy code</span>
    </button>
  </figcaption>
  <slot />
</figure>

<script>
  import '../../scripts/copy-code.js'
</script>
