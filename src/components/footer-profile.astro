---
import { footer } from '@/content/navigation'
import Subscribe from './subscribe.astro'
import Icon from './icon.astro'
import Link from './link.astro'

const linkClass =
  'flex flex-row items-center gap-2 text-base font-ui lowercase text-body hover:text-link-hover transition duration-200'

const elsewhere = [
  { href: 'https://x.com/irsteve', icon: 'x', title: 'x.com' },
  { href: 'https://www.figma.com/@stevemckinney', icon: 'figma', title: 'Figma' },
  { href: 'https://github.com/stevemckinney', icon: 'github', title: 'Github' },
  {
    href: 'https://www.linkedin.com/in/steve-mckinney-5b5836102/',
    icon: 'linkedin',
    title: 'Linkedin',
  },
  { href: 'https://mastodon.design/@steve', icon: 'mastodon', title: 'Mastodon', rel: 'me' },
]
---

<aside
  class="grid grid-flow-dense grid-cols-2 sm:grid-cols-[repeat(16,minmax(min-content,1fr))] grid-rows-[repeat(auto-fill,minmax(min-content,1fr))] gap-px col-start-container-start col-end-container-end shadow-placed rounded-lg lg:rounded-xl overflow-hidden"
>
  <Subscribe
    class="col-span-full lg:col-span-8 xl:col-span-7 row-span-10 bg-surface py-12 px-8 sm:px-12 sm:py-12 md:px-[5vmax] xl:py-16 xl:px-24"
  />

  <div
    class="@container/about col-span-full sm:col-span-8 xl:col-span-9 row-span-7 bg-surface py-12 px-8 sm:px-12 sm:py-12 xl:px-18 content-end dark:shadow-[-1px_1px_0_0_var(--color-surface-02)]"
  >
    <h3
      class="text-heading font-display font-variation-bold text-lg sm:text-3xl lowercase flex gap-2 mb-3"
    >
      About the website
    </h3>
    <div class="flex flex-col @md:flex-row gap-x-6 gap-y-2">
      <p class="text-ui-body text-base flex-1">
        Hi, I’m Steve McKinney, I write this small publication focusing on the
        design and build of websites. The aim is to bridge the gap between your
        design tool and code. And look at the craft behind creating websites.
      </p>
      <p class="text-ui-body text-base flex-1">
        This is a broad topic in itself, which feels challenging to achieve. But
        it remains a way to encourage self learning and sharing what I know…
        <Link
          href="/about"
          class="font-semibold text-link hover:text-link-hover transition duration-200 ease"
        >
          continue reading
        </Link>
      </p>
    </div>
  </div>

  <div
    class="col-span-1 sm:col-span-8 lg:col-span-4 xl:col-span-5 row-span-3 bg-surface py-12 px-8 sm:px-12 sm:py-12 xl:px-18 flex flex-col justify-end dark:shadow-[-1px_0_0_0_var(--color-surface-02)]"
  >
    <h3
      class="text-heading font-display font-variation-bold text-lg sm:text-3xl lowercase mb-4"
    >
      Site
    </h3>
    <ul class="flex flex-row flex-wrap gap-x-6 gap-y-2 sm:gap-y-4">
      {
        footer.map((link) => (
          <li>
            <Link href={link.href} class={linkClass}>
              <Icon icon={link.icon} size={link.size} variant="header" />
              {link.title}
            </Link>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="col-span-1 sm:col-span-8 lg:col-span-4 xl:col-span-4 row-span-1 bg-surface py-8 sm:p-12 flex items-center justify-center dark:shadow-[-1px_1px_var(--color-surface-02)]"
  >
    <Link href="https://v7.iamsteve.me" class={linkClass}>
      Old design
      <Icon icon="external" variant="header" size={16} />
    </Link>
  </div>

  <div
    class="col-span-1 sm:col-span-8 lg:col-span-4 xl:col-span-4 row-span-2 bg-surface py-12 px-8 sm:px-12 sm:py-12 xl:px-18 flex flex-col justify-end dark:shadow-[-1px_0_var(--color-surface-02)]"
  >
    <h3
      class="text-heading font-display font-variation-bold text-lg sm:text-3xl lowercase mb-4"
    >
      Elsewhere
    </h3>
    <ul class="flex flex-row flex-wrap gap-x-6 gap-y-2 sm:gap-y-4">
      {
        elsewhere.map(({ href, icon, title, rel }) => (
          <li>
            <Link href={href} class={linkClass} rel={rel}>
              <Icon icon={icon} size={16} variant="header" />
              {title}
            </Link>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
