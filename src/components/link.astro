---
// Internal and anchor links stay as they are. Anything else gets
// noopener noreferrer, as components/link.js does
const { href, class: ownClass, className, ...attributes } = Astro.props
const external = href && !href.startsWith('/') && !href.startsWith('#')
---

<a
  rel={external ? 'noopener noreferrer' : undefined}
  href={href}
  class={ownClass ?? className}
  {...attributes}
>
  <slot />
</a>
