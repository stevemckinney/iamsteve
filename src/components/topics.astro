---
// The category or collection list from components/topics.js: a button that
// reads as a select would, and the sheet it opens. Pages show it below the
// md breakpoint, so the island hydrates only there
import Topics from './islands/topics.jsx'

const { items, current, label, icon, class: className } = Astro.props
// Only what the list shows goes into the island’s props
const list = items.map(({ slug, title, icon }) => ({ slug, title, icon }))
---

<Topics
  client:media="(width < 48rem)"
  items={list}
  current={current}
  label={label}
  icon={icon}
  className={className}
/>
