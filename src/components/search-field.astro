---
// The button dressed as a search field from components/search-field.js,
// opening search in the field’s `scope`. Both pages that use it hide it
// below md, so it hydrates from md up
import SearchField from './islands/search-field.jsx'

const { class: className, scope } = Astro.props
---

<SearchField client:media="(width >= 48rem)" className={className} scope={scope}><slot /></SearchField>
