---
// components/figure-modal.js: the figure in a button that opens its image
// in a lightbox, once the island is on screen. `src` and `alt` are the
// image’s, for the lightbox to show
import FigureModal from './islands/figure-modal.jsx'

const { src, alt } = Astro.props
---

<FigureModal client:visible src={src} alt={alt}><slot /></FigureModal>
