---
// components/table-of-contents: the post’s headings, collapsible, open on
// desktop. Each instance hydrates at the widths `media` names, where its
// wrapper shows
import TableOfContents from './islands/table-of-contents.jsx'

const { headings, open = false, media } = Astro.props
---

<TableOfContents client:media={media} headings={headings} open={open} />
