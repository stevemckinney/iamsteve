---
// The contact form island, sending through the contact action. It hydrates
// once it’s in view. Turnstile’s flag and site key are read at build, as
// Next.js inlined them; the action reads its own values when it runs
import ContactForm from './islands/contact-form.jsx'

const enableTurnstile = import.meta.env.NEXT_PUBLIC_ENABLE_TURNSTILE === 'true'
const turnstileSiteKey = import.meta.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY
---

<ContactForm
  client:visible
  enableTurnstile={enableTurnstile}
  turnstileSiteKey={turnstileSiteKey}
/>
