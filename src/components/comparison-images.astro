---
// components/comparison-images.js as it first renders: the segmented
// control over the stacked images, showing the default option. Switching
// between them arrives with its island. `images` holds each image’s props
import Image from './image.astro'

const {
  images,
  description = 'Compare states',
  options = [
    { label: 'Before', value: 0 },
    { label: 'After', value: 1 },
  ],
  contextLabel,
} = Astro.props

// Without a default, findIndex’s -1 survives the || and nothing shows
const activeIndex = options.findIndex((opt) => opt.default) || 0
const validOptions = options.slice(0, 5)
---

<div
  class="flex flex-col gap-1 bg-neutral-01-100/80 dark:bg-surface shadow-placed dark:shadow-[inset_0_0_0_1px_var(--color-surface-02)] p-1 -mx-1 sm:-mx-9 rounded-[28px]"
  role="region"
  aria-label={description}
>
  <div class="flex w-full gap-3 p-1 items-center ml-4 relative">
    {
      contextLabel && (
        <span class="text-sm text-heading/60 pt-2 pb-1.5 order-last">
          {contextLabel}
        </span>
      )
    }
    <div
      class="flex gap-px items-center justify-end bg-[url(/images/texture.png)] bg-size-[172px_auto] bg-blend-multiply bg-canvas shadow-[inset_0_0_0_1px_rgb(162_143_140/.24),_inset_0_1px_1px_-0.5px_rgb(162_143_140/.2),_inset_0_1px_3px_-1.5px_rgb(162_143_140/.2),_inset_0_2px_4px_-2px_rgb(162_143_140/.2),_inset_0_3px_6px_-3px_rgb(162_143_140/.2),_0_1px_rgb(252_249_248/1),_0_1px_1px_rgb(252_249_248/1)] dark:shadow-[inset_0_0_0_1px_var(--color-surface-raised)] rounded-[10px] p-1"
      role="tablist"
      aria-label="View options"
    >
      {
        validOptions.map((option, index) => (
          <>
            <button
              role="tab"
              aria-selected={activeIndex === index ? 'true' : 'false'}
              aria-controls={`view-${index}`}
              class={`
                  transition-all duration-200 rounded-[7px] shadow-[0_0_0_0_rgb(0_0_0/0)] hover:text-heading active:shadow-[0_0_0_0_rgb(0_0_0/0)] active:bg-[light-dark(var(--color-neutral-01-200),var(--color-fern-1300))] active:scale-[.99375] bg-clip-padding transition duration-200 ease-in
                  text-sm pt-2 pb-1.5 px-4 text-ui-body
                  ${
                    activeIndex === index
                      ? 'bg-surface shadow-placed dark:shadow-[inset_0_0_0_1px_var(--color-surface-raised)]'
                      : ''
                  }
                `}
            >
              {option.label}
            </button>
            {index < validOptions.length - 1 && (
              <div
                class={`
                    h-4 w-px bg-neutral-01-500/20
                    transition-opacity duration-200
                    ${
                      activeIndex === index || activeIndex === index + 1
                        ? 'opacity-0'
                        : 'opacity-100'
                    }
                  `}
                aria-hidden="true"
              />
            )}
          </>
        ))
      }
    </div>
  </div>
  <div
    class="rounded-lg overflow-hidden grid grid-cols-1 grid-rows-1 before:content-[''] before:rounded-lg before:mix-blend-soft-light before:shadow-[inset_0_0_0_1px_black]  before:z-10 before:col-start-1 before:row-start-1 after:content-[''] after:rounded-lg after:mix-blend-soft-light after:shadow-[inset_0_0_0_1px_black] after:z-10 after:col-start-1 after:row-start-1 after:opacity-50"
    tabindex="0"
  >
    {
      images.map((image, index) => (
        <div
          id={`view-${index}`}
          role="tabpanel"
          aria-labelledby={`button-${index}`}
          class={`col-start-1 row-start-1`}
        >
          <Image
            {...image}
            alt={
              image.alt ||
              `${description} - ${validOptions[index]?.label || ''} state`
            }
            class={`transition-opacity duration-1000 linear data-[active=true]:delay-0
                  data-[active=false]:delay-150 w-full`}
            data-active={activeIndex === index ? 'true' : 'false'}
            style={{
              opacity: activeIndex === index ? 1 : 0,
              objectFit: 'contain',
            }}
          />
        </div>
      ))
    }
  </div>

  <span class="sr-only">
    Use the segmented control above to switch between views. Currently
    showing {validOptions[activeIndex]?.label} state.
  </span>
</div>
